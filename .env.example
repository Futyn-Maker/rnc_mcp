# RNC MCP Server Configuration
# Copy this file to .env and fill in your actual values

# Russian National Corpus API Token
# Get your token at: https://ruscorpora.ru/accounts/profile/for-devs
# Required for STDIO transport (local usage).
# Not needed for HTTP transport — users provide their own tokens via bearer auth.
RNC_API_TOKEN=your_token_here

# Multi-page fetching settings (optional)
# Delay in seconds between page requests during multi-page collection
RNC_PAGE_DELAY=0.5
# Max consecutive failures before aborting multi-page fetch
RNC_MAX_RETRIES=3

# Auth cache TTL in seconds (how long validated tokens are cached)
# Only applies to HTTP transport
RNC_AUTH_CACHE_TTL=300

# OAuth settings (HTTP transport only)
#
# Database connection URL for OAuth data (clients, tokens).
# Any SQLAlchemy-supported backend works: sqlite, postgresql, mysql, ...
# Examples:
#   sqlite:////tmp/oauth.db                                              (default; ephemeral in cloud)
#   sqlite:////var/lib/rnc_mcp/oauth.db                                  (persistent SQLite, self-hosted)
#   postgresql://user:pass@host:5432/db                                  (self-hosted PostgreSQL)
#   postgresql://postgres.<ref>:<pass>@aws-0-<region>.pooler.supabase.com:5432/postgres  (Supabase Session Pooler — IPv4)
# Legacy RNC_OAUTH_DB_PATH is still honored when RNC_DATABASE_URL is unset.
RNC_DATABASE_URL=sqlite:////tmp/oauth.db
#
# Fernet key used to encrypt RNC tokens at rest.
# Required when RNC_DATABASE_URL is not SQLite — without a stable key,
# encrypted tokens become un-decryptable across server restarts.
# For SQLite, the key is auto-generated next to the DB file if absent.
# Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
RNC_FERNET_KEY=
#
# Public base URL for OAuth metadata endpoints
# Set this to your server's public URL in production
RNC_OAUTH_BASE_URL=http://127.0.0.1:8000
