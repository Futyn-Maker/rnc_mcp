# E2E Test Configuration
# Copy this file to .env.e2e and fill in your actual values.
# This file is separate from the main .env file.

# Russian National Corpus API Token (required for E2E tests)
# Get your token at: https://ruscorpora.ru/accounts/profile/for-devs
RNC_API_TOKEN=your_token_here

# Server URL for E2E tests (default: http://127.0.0.1:8000/mcp)
# Uncomment and modify to test against a remote server
# E2E_SERVER_URL=http://127.0.0.1:8000/mcp
