{
  "$schema": "https://gofastmcp.com/public/schemas/fastmcp.json/v1.json",
  "source": {
    "type": "filesystem",
    "path": "main.py",
    "entrypoint": "mcp"
  },
  "environment": {
    "type": "uv",
    "python": ">=3.13",
    "requirements": "requirements.txt"
  },
  "deployment": {
    "transport": "http",
    "host": "127.0.0.1",
    "port": 8000,
    "log_level": "INFO",
    "env": {
      "RNC_API_TOKEN": "${RNC_API_TOKEN}",
      "RNC_PAGE_DELAY": "${RNC_PAGE_DELAY}",
      "RNC_MAX_RETRIES": "${RNC_MAX_RETRIES}",
      "RNC_AUTH_CACHE_TTL": "${RNC_AUTH_CACHE_TTL}",
      "RNC_OAUTH_BASE_URL": "${RNC_OAUTH_BASE_URL}",
      "RNC_OAUTH_DB_PATH": "${RNC_OAUTH_DB_PATH}",
      "RNC_DATABASE_URL": "${RNC_DATABASE_URL}",
      "RNC_FERNET_KEY": "${RNC_FERNET_KEY}"
    }
  }
}
